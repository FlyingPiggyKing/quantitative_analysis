# remote_data/.env.example
# Copy to .env and fill values. NEVER commit the real .env.

# === Required ===
DEPLOY_ROLE=LOCAL
REMOTE_INGEST_URL=https://8.153.90.28:443/api/etf/ingest
ETF_PIPELINE_SECRET=replace-with-32+-byte-random-string

# === Optional (defaults shown) ===
LOCAL_DB_PATH=data/etf_local.db
TIME_WINDOW_SECONDS=300
HTTP_TIMEOUT_SECONDS=15
YAHOOQUERY_MAX_RETRIES=3
YAHOOQUERY_BACKOFF_SECONDS=2

# Comma-separated ETF tickers; default list used if unset.
# SYMBOLS=QQQ,IVV,SPY,VTI,VOO,QQQM,SCHB,ITOT,VEA,VWO,BND,AGG,TLT,IEF,GLD,SLV,USO,UNG,ARKK,SOXX

FETCH_QUOTES_INTERVAL_MINUTES=5
FETCH_QUOTES_OFFHOURS_INTERVAL_MINUTES=30
FETCH_NEWS_INTERVAL_MINUTES=60
PUSH_INTERVAL_SECONDS=30
BATCH_SIZE=500

MARKET_TZ=US/Eastern
LOG_LEVEL=INFO
LOG_FILE=data/etf_local.log