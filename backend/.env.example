# Tushare Pro API Token
# Register at https://tushare.pro and get your token
TUSHARE_TOKEN=your_token_here

# MiniMax API Key (for AI analysis)
MINIMAX_API_KEY=your_minimax_api_key
# MiniMax API Host: https://api.minimaxi.com (Mainland China) or https://api.minimax.io (Global)
MINIMAX_API_HOST=https://api.minimaxi.com

# Tavily API Key (for web search in stock trend analysis)
# Get from https://tavily.com
TAVILY_API_KEY=your_tavily_api_key

# LangSmith Tracing (for agent observability)
# Enable tracing: https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=stock_analysis

# Yahoo Finance Proxy (for Yahoo Finance RSS news only, not needed for Futu)
# Format: socks5h://127.0.0.1:10886 or http://127.0.0.1:10887
YF_PROXY=socks5h://127.0.0.1:10886

# Futu OpenD Connection (for US stock data via Futu OpenAPI)
# Default: 127.0.0.1:11111 (local OpenD)
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111

# ETF pipeline — HMAC secret shared with the overseas pusher
# (must match remote_data/.env on the overseas box). 32+ random bytes recommended.
# Required: startup aborts if missing or empty.
ETF_PIPELINE_SECRET=

# ETF remote database path (relative to backend/ unless absolute).
# example: ./data/etf_remote.db
REMOTE_DB_PATH=./data/etf_remote.db

# ETF ingest HMAC timestamp window in seconds (default 300 = 5 minutes).
# example: 300
TIME_WINDOW_SECONDS=300

# ETF ingest per-IP rate limit: requests per 24h sliding window (default 50000).
# example: 50000
INGEST_MAX_REQUESTS_PER_DAY=50000

# ETF ingest request body cap in bytes (default 1 MB).
# example: 1048576
INGEST_MAX_BODY_BYTES=1048576

# ETF rate-limit state flush interval to SQLite in seconds (default 60).
# example: 60
RATE_LIMIT_FLUSH_SECONDS=60

# ETF push monitor freshness thresholds (hours).
# The admin "ETF 数据推送监控" panel derives per-table status from lag_hours:
#   lag_hours <= WARN_HOURS    -> ok (green)
#   WARN_HOURS < lag_hours <= STALE_HOURS -> warn (amber)
#   lag_hours > STALE_HOURS    -> stale (red)
#   never pushed               -> unknown (grey)
# Read at request time; no backend restart required for tuning.
# example: 6
ETF_PUSH_WARN_HOURS=6
# example: 24
ETF_PUSH_STALE_HOURS=24
